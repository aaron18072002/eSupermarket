# =========================
# IDEs and OS Files
# =========================
.idea/
*.iml
*.iws
.vscode/
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Eclipse
.project
.classpath
.settings/

# =========================
# Database & Tools (DBeaver / DataGrip / Docker)
# =========================
.dbeaver/
.dbeaver-data-sources.xml
*.dbeaver*
**/pgdata/
pgdata/
*.dump
*.sql.bak
docker-compose.override.yml
docker-compose*.local.yml

# =========================
# Backend (Java / Spring Boot / Maven)
# =========================
# Ignore all Maven build directories in any backend service
**/target/
target/

# Ignore compiled files and packaged applications
*.class
*.jar
*.war
*.ear

# Keep Maven wrapper scripts (mvnw), but ignore the heavy JAR file
.mvn/wrapper/maven-wrapper.jar

# Ignore standard Spring Boot logs
*.log

# =========================
# Frontend (Next.js / Node.js)
# =========================
# Ignore all Node modules
**/node_modules/
node_modules/

# Next.js generated folders
**/.next/
.next/
out/
build/

# Ignore frontend error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# Environment Variables (Secrets)
# =========================
.env
.env.*.local
.env.local
.env.development
.env.production